# 复制为 .env 后填入真实值，.env 不要提交到仓库

# MySQL 连接
#   部署在 ECS 上时用 127.0.0.1（MySQL 与后端同机）
#   本地开发调试时填数据库的公网地址（需自行放行相关端口）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写数据库密码
DB_NAME=sticker_note_sync

# 服务监听端口（需在阿里云安全组放行该端口）
PORT=4000

# 配对码有效期（秒）
PAIRING_CODE_TTL_SECONDS=300

# 部署在 Nginx 等反向代理之后时设为 1，限流才能识别真实客户端 IP
TRUST_PROXY=0
