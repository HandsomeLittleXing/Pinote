# 复制为 .env 后填入真实值，.env 不要提交到仓库

# MySQL 连接
#   部署在 ECS 上时用 127.0.0.1（MySQL 与后端同机）
#   本地开发调试时填数据库的公网地址（需自行放行相关端口）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写数据库密码
DB_NAME=sticker_note_sync

# 服务监听端口（需在阿里云安全组放行该端口）
PORT=4000

# 配对码有效期（秒）
PAIRING_CODE_TTL_SECONDS=300

# 部署在 Nginx 等反向代理之后时设为 1，限流才能识别真实客户端 IP
TRUST_PROXY=0

# ===== AI 整理（DeepSeek / 任意 OpenAI 兼容接口）=====
# 客户端可通过已配对的同步空间设置 Key；服务器加密保存，客户端不持久化明文。
# 用 32 字节随机值的 Base64 编码；保存空间 Key 前必须配置，丢失后需重新输入 Key。
AI_CREDENTIALS_MASTER_KEY=
# 生产环境配置 Key 需要 HTTPS；TLS 在 Nginx 终止时设置 TRUST_PROXY=1 并限制可信代理。
LLM_BASE_URL=https://api.deepseek.com/v1
# 可选服务器默认 Key；空间 Key 优先，移除空间 Key 后回退到此值。
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=25000
# 单条便签最多发送多少字
AI_MAX_INPUT_CHARS=8000
# 限流：每个同步空间 / 每个 IP 每分钟最多调用次数
AI_RATE_LIMIT_SPACE_PER_MIN=8
AI_RATE_LIMIT_IP_PER_MIN=20
# 本地没有 Key 时设为 1，返回固定示例结果用于联调
AI_MOCK=0
